# ==============================================================================
# INTELLIGENT TRADING AGENT - MASTER COORDINATOR
# ==============================================================================

# Rete Base (L2)
BASE_RPC_URL=https://mainnet.base.org
CHAIN_ID=8453

# Modalità Operativa
# DRY_RUN: simula le chiamate on-chain senza firmare transazioni
# PAPER_TRADING: simula i saldi e le operazioni in un book virtuale locale
DRY_RUN=true
PAPER_TRADING=true
PAPER_START_USDC=10000.0

# Master Treasury Wallet (Gestore Centrale)
MASTER_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
MASTER_PRIVATE_KEY=

# Indirizzi Token su Base
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# Endpoint API dei 6 Agenti Subordinati
AGENT_PERP_URL=http://localhost:3001
AGENT_YIELD_URL=http://localhost:3002
AGENT_NEUTRAL_URL=http://localhost:3003
AGENT_LP_URL=http://localhost:3004
AGENT_DCA_URL=http://localhost:3005
AGENT_DEGEN_URL=http://localhost:3006

# Wallet Address dei 6 Agenti (opzionali se letti direttamente da /api/status)
AGENT_PERP_WALLET=
AGENT_YIELD_WALLET=
AGENT_NEUTRAL_WALLET=
AGENT_LP_WALLET=
AGENT_DCA_WALLET=
AGENT_DEGEN_WALLET=

# Token di autenticazione per triggerare /api/run sugli agenti
AGENT_RUN_TOKEN=francos88

# Credenziali HTTP Basic Auth (se i bot su CapRover/Nginx sono protetti da Basic Auth)
AGENT_HTTP_USER=scobru
AGENT_HTTP_PASS=francos88

# Parametri Orchestrazione e Allocazione
COORDINATOR_INTERVAL_SECONDS=900
AUTO_REBALANCE=false
MIN_REBALANCE_USD=25.0
REBALANCE_THRESHOLD_PCT=5.0

# Gas Balancer (ETH su Base)
AUTO_REFUEL_GAS=false
GAS_WARN_ETH=0.0015
MIN_GAS_RESERVE_ETH=0.001
REFUEL_AMOUNT_ETH=0.003
MAX_GAS_PRICE_GWEI=0.1

# Risk Management Globale
MAX_PORTFOLIO_DRAWDOWN_24H_PCT=8.0
EMERGENCY_HALT_DEGEN_ON_PANIC=true

# Master Dashboard & API
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
DASHBOARD_RUN_TOKEN=

# Master Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database SQLite
SQLITE_DB_PATH=coordinator.db
